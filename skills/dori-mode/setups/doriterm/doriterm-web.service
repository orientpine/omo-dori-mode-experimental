[Unit]
Description=doriterm web app with the WebKit device-key fix, on loopback for tailscale serve (see setups/doriterm/README.md)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.bun/bin/bun %h/.dori/src/skills/dori-mode/setups/doriterm/web/serve.ts %h/.local/share/doriterm-web/current
Environment=DORITERM_WEB_PORT=7780
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
