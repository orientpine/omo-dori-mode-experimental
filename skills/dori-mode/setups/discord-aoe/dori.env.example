# Copy to ~/.dori/dori.env and chmod 600. Every dori command and every unit in systemd/ reads it.
# The ids below are placeholders: turn on Developer Mode in Discord, then right-click > Copy ID.

# Bot token (Developer Portal > your app > Bot > Reset Token). Turn on the Message Content intent there too.
DORI_DISCORD_TOKEN=replace-with-your-bot-token
# The server, the one channel the Dori talks in, and the owner's user id.
DORI_DISCORD_GUILD=111111111111111111
DORI_DISCORD_CHANNEL=222222222222222222
DORI_DISCORD_OWNER=333333333333333333

# The Dori's own aoe session: id from `aoe list --json`, tmux name from `tmux ls`.
DORI_LEAD_AOE_ID=0a1b2c3d4e5f6a7b
DORI_LEAD_TMUX=aoe_Dori_0a1b2c3d

# Optional. Id of the owner's own webhook in that channel (e.g. an iOS Shortcut voice upload); its posts count as the
# owner's. Leave unset until the first post logs DISCORD_WEBHOOK_UNKNOWN id=... See ios-shortcut-voice.md.
# DORI_DISCORD_OWNER_WEBHOOK=
# Optional. Inbox file the listener appends to (default ~/.dori/state/discord/inbox.jsonl).
# DORI_DISCORD_INBOX=
# Optional. Where question cards and answers live (default ~/.dori/state/discord).
# DORI_DISCORD_STATE_DIR=
# Optional. A channel shared with a second Dori and that Dori's bot id: rows with scope "pair" / "pair-bot".
# DORI_DISCORD_PAIR_CHANNEL=
# DORI_DISCORD_PAIR_BOT=
# Shadow run only, never in this file: DORI_DISCORD_SHADOW_INBOX=<file> (see README, "Switching an existing listener over").
# Optional. Speech-to-text install dir and language for transcribe.sh (default ~/.dori/asr, auto).
# DORI_ASR_DIR=
# DORI_ASR_LANG=en
