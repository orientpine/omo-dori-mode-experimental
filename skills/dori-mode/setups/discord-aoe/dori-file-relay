    except OSError as e:
        if e.errno in (errno.ELOOP, errno.ENOTDIR):
            raise Refused("symlink") from None
        raise

def make_dir(name, fd, me):
    if lstat_at(name, fd) is None:
        os.mkdir(name, 0o700, dir_fd=fd)
    return open_dir(name, fd, me)

def home_fd():
    home = sys.argv[3] or pwd.getpwuid(os.getuid()).pw_dir
    if not sys.argv[3] and (not home.startswith("/home/") or home.count("/") != 2):
        raise Refused("odd-home")
    return os.open(home, NOFOLLOW_DIR), home

def run(main):
    try:
        main()
    except Refused as e:
        sys.stderr.write("REFUSED %s\n" % e)
        sys.exit(3)
