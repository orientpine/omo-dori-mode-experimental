# Lists every entry under ~/outbox/to-<dori>/ (made 0700 when missing) as one JSON object on stdout.
SCAN = COMMON + r'''
SKIP_SUFFIX = (".part", ".tmp", ".crdownload", ".swp", "~")

def open_for_write():
    """(dev, ino) of every file a process of this account holds open for writing."""
    me, out = os.getuid(), set()
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == os.getpid():
            continue
        try:
            if os.stat("/proc/" + pid).st_uid != me:
                continue
            fds = os.listdir("/proc/%s/fd" % pid)
        except OSError:
            continue
        for n in fds:
            try:
                with open("/proc/%s/fdinfo/%s" % (pid, n)) as f:
                    flags = next(int(l.split()[1], 8) for l in f if l.startswith("flags:"))
                if flags & 3 == 0:
                    continue
                st = os.stat("/proc/%s/fd/%s" % (pid, n))
                out.add((st.st_dev, st.st_ino))
            except (OSError, StopIteration, ValueError):
                pass
    return out

def main():
    targets = json.loads(sys.argv[4])
    me = os.getuid()
    fd, _ = home_fd()
    ob = make_dir("outbox", fd, me)
    rows, errors = [], []

    def walk(dfd, to, prefix, depth):
        for name in sorted(os.listdir(dfd)):
            if name.startswith(".") or name.endswith(SKIP_SUFFIX):
                continue
            st = lstat_at(name, dfd)
            if st is None:
                continue
            row = {"to": to, "rel": prefix + name, "size": st.st_size, "mtime": st.st_mtime_ns, "dev": st.st_dev,
                   "ino": st.st_ino, "nlink": st.st_nlink}
            if stat.S_ISDIR(st.st_mode):
                if st.st_uid != me:
                    rows.append(dict(row, type="folder-not-owned"))
                elif depth >= 6:
                    rows.append(dict(row, type="path-too-deep"))
                else:
                    sub = os.open(name, NOFOLLOW_DIR, dir_fd=dfd)
                    try:
                        walk(sub, to, prefix + name + "/", depth + 1)
                    finally:
                        os.close(sub)
            elif stat.S_ISREG(st.st_mode):
                rows.append(dict(row, type="reg"))
            elif stat.S_ISLNK(st.st_mode):
                rows.append(dict(row, type="symlink"))
            else:
                rows.append(dict(row, type="not-a-regular-file"))

    for to in targets:
        try:
            tfd = make_dir("to-" + to, ob, me)
        except Refused as e:
            errors.append({"to": to, "error": str(e)})
            continue
        try:
            walk(tfd, to, "", 0)
        finally:
            os.close(tfd)
    if any(r["type"] == "reg" for r in rows):
        writing = open_for_write()
        for r in rows:
            r["writing"] = (r["dev"], r["ino"]) in writing
    sys.stdout.write(json.dumps({"rows": rows, "errors": errors}))

run(main)
