class Refused(Exception):
    pass


def log(entry: dict) -> None:
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    entry = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), **entry}
    fd = os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        os.write(fd, (json.dumps(entry, ensure_ascii=False) + "\n").encode())
    finally:
        os.close(fd)


def under(path: str, account: str, folder: str) -> str:
    """Return path relative to /home/<account>/<folder>; an absolute path elsewhere is refused."""
    for prefix in (f"/home/{account}/{folder}/", f"~/{folder}/"):
        if path.startswith(prefix):
            return path[len(prefix):]
    if path.startswith("/") or path.startswith("~"):
        raise Refused(f"outside-{folder}")
    return path


def helper(account: str, role: str, code: str, args: list) -> tuple:
    data = code.encode()
    if TEST_HOMES:
        prefix, home = [], os.path.join(TEST_HOMES, account)
    else:
        prefix, home = ["sudo", "-n", "-u", account, "-H", "--"], ""
    cmd = [*prefix, "/usr/bin/python3", "-I", "-c", BOOT, str(len(data)), role, home, *args]
    return subprocess.Popen(cmd, cwd="/", stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, start_new_session=True), data


def call(account: str, role: str, code: str, args: list, data: bytes = b"", timeout: int = 120) -> tuple:
    """Run a small helper to the end: (stdout, last stderr line); a refusal raises Refused, a failure RuntimeError."""
    p, boot = helper(account, role, code, args)
    try:
        out, err = p.communicate(boot + data, timeout=timeout)
    except subprocess.TimeoutExpired:
        p.kill()
        p.communicate()
        raise RuntimeError(f"{role} timed out") from None
    line = last_line(err)
    if p.returncode == 3 and line.startswith("REFUSED "):
        raise Refused(line.split(" ", 1)[1])
    if p.returncode != 0:
        raise RuntimeError(f"{role} rc={p.returncode} {line[:200]}")
    return out, line


def last_line(stderr: bytes) -> str:
    lines = [l for l in stderr.decode(errors="replace").splitlines() if l.strip()]
    return lines[-1] if lines else ""


def relay(src_acct: str, src: str, dst_acct: str, dest: str | None, replace: bool, cap: int, entry: dict,
          accounts: tuple) -> tuple:
    """Copy one file; returns (RELAYED message, info with bytes, sha256, ident of the file read, replaced)."""
    for a in (src_acct, dst_acct):
        if a not in accounts:
            raise Refused("unknown-account")
    if src_acct == dst_acct:
        raise Refused("same-account")
    rel = under(src, src_acct, "outbox")
    entry["src"] = f"{src_acct}:outbox/{rel}"
    name = rel.rsplit("/", 1)[-1]
    if dest is None:
        drel = name
    else:
        drel = under(dest, dst_acct, "inbox")
        if drel == "" or drel.endswith("/"):
            drel += name
    entry["dest"] = f"{dst_acct}:inbox/{drel}"
    for r in (rel, drel):
        ps = r.split("/")
        if not r or len(ps) > 8 or any(p in ("", ".", "..") for p in ps) or "\x00" in r:
            raise Refused("path-escape")

    stage = tempfile.mkdtemp(prefix="dori-file-relay.")
    staged = os.path.join(stage, "data")
    try:
        # 1. read as <from> into a private staging file
        p, code = helper(src_acct, "reader", READER, [rel, str(cap)])
        out = os.open(staged, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        p.stdin.write(code)
        p.stdin.close()
        while True:
            b = p.stdout.read(CHUNK)
            if not b:
                break
            os.write(out, b)
        os.close(out)
        err = p.stderr.read()
        p.wait()
        line = last_line(err)
        if p.returncode == 3 and line.startswith("REFUSED "):
            raise Refused(line.split(" ", 1)[1])
        if p.returncode != 0 or not line.startswith("READ "):
            raise RuntimeError(f"reader rc={p.returncode} {line[:200]}")
        _, size_s, sha, dev, ino, mtime = line.split()
        size = int(size_s)
        h = hashlib.sha256()
        with open(staged, "rb") as f:
            for b in iter(lambda: f.read(CHUNK), b""):
                h.update(b)
        if os.path.getsize(staged) != size or h.hexdigest() != sha:
            raise RuntimeError("staging sha mismatch")
        entry.update(bytes=size, sha256=sha)

        # 2. write as <to> into its inbox, the receiver re-reads and checks the sha
        p, code = helper(dst_acct, "writer", WRITER, [drel, str(cap), sha, str(size), "1" if replace else "0"])
        try:
            p.stdin.write(code)
            with open(staged, "rb") as f:
                for b in iter(lambda: f.read(CHUNK), b""):
                    p.stdin.write(b)
            p.stdin.close()
        except BrokenPipeError:
            pass
        err = p.stderr.read()
        p.wait()
        line = last_line(err)
        if p.returncode == 3 and line.startswith("REFUSED "):
            raise Refused(line.split(" ", 1)[1])
        if p.returncode != 0 or not line.startswith("WROTE "):
            raise RuntimeError(f"writer rc={p.returncode} {line[:200]}")
        _, replaced, _, _, path = line.split(" ", 4)
        info = {"bytes": size, "sha256": sha, "ident": [int(dev), int(ino), size, int(mtime)], "drel": drel,
                "replaced": replaced == "1"}
        return f"RELAYED {dst_acct}:{path} bytes={size} sha256={sha}", info
    finally:
        try:
            os.unlink(staged)
        except FileNotFoundError:
            pass
        os.rmdir(stage)


def parse_doris(spec: str) -> dict:
    """DORI_FILE_RELAY_DORIS -> {dori: (account, inbox)}."""
    doris = {}
    for item in spec.split():
        name, _, rest = item.partition("=")
        acct, _, inbox = (rest or name).partition(":")
        if not re.fullmatch(r"[a-z][a-z0-9-]{0,30}", name) or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", acct):
            raise ValueError(f"bad DORI_FILE_RELAY_DORIS item {item!r}")
        doris[name] = (acct, inbox)
    return doris


# A refusal that can clear by itself: the next scan tries again.
RETRY = {"not-found", "changed-while-reading", "changed-after-send"}
MAX_ERRORS = 3


class Server:
    def __init__(self, doris: dict, cap: int, settle: float, interval: float):
        self.doris, self.cap, self.settle, self.interval = doris, cap, settle, interval
        self.accounts = tuple(a for a, _ in doris.values())
        self.prev, self.errors, self.delivered, self.scan_errors = {}, {}, {}, {}

    def kst_date(self) -> str:
        return time.strftime("%Y-%m-%d", time.gmtime(time.time() + 9 * 3600))

    def scan(self, name: str) -> list:
        acct = self.doris[name][0]
        others = [d for d in self.doris if d != name]
        try:
            out, _ = call(acct, "scan", SCAN, [json.dumps(others)])
            res = json.loads(out)
            problem = json.dumps(res["errors"], sort_keys=True) if res["errors"] else ""
        except (Refused, RuntimeError, ValueError) as e:
            res, problem = {"rows": []}, f"{type(e).__name__}: {e}"[:300]
        if problem != self.scan_errors.get(name, ""):  # logged once when it starts and once when it clears
            log({"mode": "auto", "event": "scan_problem" if problem else "scan_ok", "dori": name, "account": acct,
                 "reason": problem})
            self.scan_errors[name] = problem
        return res["rows"]

    def move(self, name: str, row: dict, op: str, ident: list | None, why: dict | None = None) -> str:
        _, line = call(self.doris[name][0], "move", MOVE,
                       [op, "to-" + row["to"], row["rel"], json.dumps(ident) if ident else "-", self.kst_date()],
                       json.dumps(why or {}, ensure_ascii=False).encode())
        return line.split(" ", 1)[1] if line.startswith("MOVED ") else ""

    def fail(self, name: str, row: dict, reason: str, entry: dict) -> None:
        why = {"reason": reason, "to": row["to"], "path": row["rel"], "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
        try:
            moved = self.move(name, row, "failed", None, why)
            entry.update(result="failed", reason=reason, failed_as=f".failed/{moved}" if moved else "")
        except (Refused, RuntimeError) as e:
            entry.update(result="failed", reason=reason, failed_move=str(e)[:200])
        log(entry)

    def wake(self, name: str, to: str, info: dict) -> None:
        acct, inbox = self.doris[to]
        path = info["drel"]
        now = time.time()
        line = {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(now)) + ".%03dZ" % (int(now * 1000) % 1000),
            "id": f"file-delivered-{info['sha256'][:12]}-{int(now)}",
            "kind": "file-delivered",
            "from": name,
            "to": to,
            "path": path,
            "bytes": info["bytes"],
            "sha256": info["sha256"],
            "replaced": info["replaced"],
            "content": (f"{name}가 파일을 보냈어: ~/inbox/{path} ({info['bytes']} B, sha256 {info['sha256'][:12]}…)"
                        + (", 같은 이름의 옛 파일을 바꿈" if info["replaced"] else "")
                        + ". 파일 내용은 이 줄에 없어."),
        }
        if not inbox:
            raise RuntimeError("no inbox set")
        call(acct, "inbox", INBOX, [inbox], (json.dumps(line, ensure_ascii=False) + "\n").encode())

    def deliver(self, name: str, row: dict, key: tuple, sig: tuple) -> None:
        src_acct, dst_acct = self.doris[name][0], self.doris[row["to"]][0]
        entry = {"mode": "auto", "from": src_acct, "to": dst_acct, "replace": True, "max_bytes": self.cap}
        if row["type"] != "reg":
            entry["src"] = f"{src_acct}:outbox/to-{row['to']}/{row['rel']}"
            return self.fail(name, row, row["type"], entry)
        try:
            _, info = relay(src_acct, f"to-{row['to']}/{row['rel']}", dst_acct, f"from-{name}/{row['rel']}", True,
                            self.cap, entry, self.accounts)
        except Refused as e:
            if str(e) in RETRY:
                return log(dict(entry, result="retry", reason=str(e)))
            return self.fail(name, row, str(e), entry)
        except Exception as e:  # logged; after MAX_ERRORS the file is set aside with the reason
            n = self.errors[key] = self.errors.get(key, 0) + 1
            reason = f"{type(e).__name__}: {e}"[:300]
            if n >= MAX_ERRORS:
                return self.fail(name, row, f"error x{n}: {reason}", entry)
            return log(dict(entry, result="error", reason=reason, attempt=n))
        entry.update(result="ok", replaced=info["replaced"])
        try:
            self.wake(name, row["to"], info)
            entry["woke"] = True
        except (Refused, RuntimeError) as e:
            entry.update(woke=False, wake_error=str(e)[:200])
        try:
            entry["sent_as"] = f"sent/{self.kst_date()}/to-{row['to']}/{self.move(name, row, 'sent', info['ident'])}"
        except (Refused, RuntimeError) as e:  # still there: not sent twice while this service runs
            self.delivered[key] = sig
            entry["sent_move"] = str(e)[:200]
        self.errors.pop(key, None)
        log(entry)

    def cycle(self) -> None:
        now, seen = time.time_ns(), set()
        for name in self.doris:
            for row in self.scan(name):
                key = (name, row["to"], row["rel"])
                sig = (row["type"], row["size"], row["mtime"], row["dev"], row["ino"], row["nlink"])
                seen.add(key)
                steady = self.prev.get(key) == sig
                self.prev[key] = sig
                if row["type"] == "reg":
                    if row.get("writing") or not steady or now - row["mtime"] < self.settle * 1e9:
                        continue
                    if self.delivered.get(key) == sig:
                        continue
                self.deliver(name, row, key, sig)
        for d in (self.prev, self.errors, self.delivered):
            for k in [k for k in d if k not in seen]:
                del d[k]

    def serve(self, cycles: int) -> None:
        log({"mode": "auto", "event": "start", "doris": {d: a for d, (a, _) in self.doris.items()},
             "settle_sec": self.settle, "interval_sec": self.interval})
        n = 0
        while cycles == 0 or n < cycles:
            if n:
                time.sleep(self.interval)
            self.cycle()
            n += 1


def number(name: str, default: float) -> float:
    try:
        return float(os.environ.get(name, default))
    except ValueError:
        return default


def main() -> int:
    args = sys.argv[1:]
    try:
        cap = int(os.environ.get("DORI_FILE_RELAY_MAX_BYTES", DEFAULT_MAX))
    except ValueError:
        cap = DEFAULT_MAX
    try:
        doris = parse_doris(os.environ.get("DORI_FILE_RELAY_DORIS", ""))
    except ValueError as e:
        sys.stderr.write(f"dori-file-relay: {e}\n")
        return 2
    if args[:1] == ["--serve"]:
        cycles = int(args[2]) if args[1:2] == ["--cycles"] and len(args) == 3 else 0
        if len(args) not in (1, 3) or (len(args) == 3 and args[1] != "--cycles"):
            sys.stderr.write(__doc__)
            return 2
        if len(doris) < 2:
            sys.stderr.write("dori-file-relay --serve: set DORI_FILE_RELAY_DORIS (two Dori accounts or more)\n")
            return 2
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        lock = open(os.path.join(STATE, "serve.lock"), "w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            sys.stderr.write("dori-file-relay --serve: already running\n")
            return 1
        Server(doris, cap, number("DORI_FILE_RELAY_SETTLE_SEC", 10), number("DORI_FILE_RELAY_INTERVAL", 10)).serve(cycles)
        return 0
    replace = "--replace" in args
    args = [a for a in args if a != "--replace"]
    if len(args) not in (3, 4) or any(a in ("-h", "--help") for a in args):
        sys.stderr.write(__doc__)
        return 2
    accounts = tuple(dict.fromkeys([*DEFAULT_ACCOUNTS, *(a for a, _ in doris.values())]))
    entry = {"from": args[0], "to": args[2], "replace": replace, "max_bytes": cap}
    try:
        msg, _ = relay(args[0], args[1], args[2], args[3] if len(args) == 4 else None, replace, cap, entry, accounts)
    except Refused as e:
        entry.update(result="refused", reason=str(e))
        log(entry)
        print(f"RELAY_REFUSED {e}")
        return 3
    except Exception as e:  # logged and reported, never swallowed
        entry.update(result="error", reason=f"{type(e).__name__}: {e}"[:300])
        log(entry)
        print(f"RELAY_ERROR {entry['reason']}")
        return 1
    entry["result"] = "ok"
    log(entry)
    print(msg)
    return 0


if __name__ == "__main__":
    sys.exit(main())
