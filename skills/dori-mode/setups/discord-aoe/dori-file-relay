#!/usr/bin/python3 -I
"""dori-file-relay: hand files from one Dori account to another on this host.

    dori-file-relay [--replace] <from> <file> <to> [dest]    one file, by hand
    dori-file-relay --serve [--cycles N]                     the delivery service (unit dori-file-relay)

Runs as the account that may sudo -n -u every Dori account on the host (oriclaw/ZzangDori on ori0a83) and uses only
those rights; no new root, sudo or firewall rule. Accounts: DORI_FILE_RELAY_DORIS (below) or oriclaw okdori moodori
yoodori gongdori.

By hand: <file> is read as <from> and only from /home/<from>/outbox (relative to it, or an absolute path under it). The
copy is written as <to> into /home/<to>/inbox (dest relative to it, default the same name; a dest ending in / keeps the
name), mode 0600, inbox and new folders 0700. Refused (exit 3, RELAY_REFUSED <reason>): unknown or same account, a path
leaving the folder (.., absolute elsewhere), a symlink anywhere on the path, a non-regular file, a file with more than one
hard link, a file over the size cap (DORI_FILE_RELAY_MAX_BYTES, default 100 MiB), an existing dest without --replace.
Success prints RELAYED <to>:<path> bytes=<n> sha256=<hex> after the receiver re-read the file and got the same sha256.

Service: DORI_FILE_RELAY_DORIS names the Dori accounts as space-separated <dori>=<account>:<lead inbox> items (the inbox
path may start with ~/, the receiving account's home), e.g. zzangdori=oriclaw:~/.zzangdori/inbox.jsonl
okdori=okdori:~/.okdori/state/discord/inbox.jsonl. Each account gets ~/outbox/to-<other dori>/ (0700). A file put
there, in subfolders too, goes to the other's ~/inbox/from-<dori>/<same relative path> with the same checks as by hand;
a file of the same name there is replaced by the new one. A file is taken only when it is not being written: names
starting with . or ending in .part .tmp .crdownload .swp ~ are skipped, and it must look the same (size, mtime, inode)
on two scans in a row, be unchanged for DORI_FILE_RELAY_SETTLE_SEC (10) and not be open for writing by any process of
its account. Scans run every DORI_FILE_RELAY_INTERVAL seconds (10). Delivered: the receiver's lead inbox gets one
kind "file-delivered" line (dori names, relative path, bytes, sha256; never the content), then the sender's file moves
to ~/outbox/sent/<KST date>/to-<dori>/<path>. Refused, or failing 3 times: the file moves to
~/outbox/to-<dori>/.failed/<path> with <path>.why next to it (the reason).

Every hand call and every delivery appends one JSON line to ~/.local/state/dori-file-relay/relay.log: names, bytes,
sha256 and the result only, never the file's content.
"""
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time

DEFAULT_ACCOUNTS = ("oriclaw", "okdori", "moodori", "yoodori", "gongdori")
DEFAULT_MAX = 100 * 1024 * 1024
STATE = os.environ.get("DORI_FILE_RELAY_STATE") or os.path.expanduser("~/.local/state/dori-file-relay")
LOG = os.path.join(STATE, "relay.log")
CHUNK = 1 << 20
# Tests only: every account is a folder under this root and helpers run as the caller, without sudo.
TEST_HOMES = os.environ.get("DORI_FILE_RELAY_TEST_HOMES", "")
# The helper's code arrives on stdin (first n bytes); a writer's file data follows it.
BOOT = ("import sys;n=int(sys.argv[1]);"
        "exec(compile(sys.stdin.buffer.read(n),'dori-file-relay-'+sys.argv[2],'exec'))")

COMMON = r'''
import errno, hashlib, json, os, pwd, stat, sys, time
CHUNK = 1 << 20
NOFOLLOW_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC

class Refused(Exception):
    pass

def parts(rel):
    if not rel or rel.startswith("/") or "\x00" in rel:
        raise Refused("bad-path")
    ps = rel.split("/")
    if len(ps) > 8 or any(p in ("", ".", "..") for p in ps):
        raise Refused("path-escape")
    return ps

def lstat_at(name, fd):
    try:
        return os.stat(name, dir_fd=fd, follow_symlinks=False)
    except FileNotFoundError:
        return None

def open_dir(name, fd, me):
    st = lstat_at(name, fd)
    if st is None:
        raise Refused("not-found")
    if stat.S_ISLNK(st.st_mode):
        raise Refused("symlink")
    if not stat.S_ISDIR(st.st_mode):
        raise Refused("not-a-directory")
    if st.st_uid != me:
        raise Refused("folder-not-owned")
    try:
