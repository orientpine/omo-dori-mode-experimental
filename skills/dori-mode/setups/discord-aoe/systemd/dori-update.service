[Unit]
Description=Apply Dori script updates and announce changed guidance
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.dori/dori.env
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/dori update
StandardOutput=append:%h/.dori/update.log
StandardError=append:%h/.dori/update.log
