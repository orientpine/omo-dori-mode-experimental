[Unit]
Description=Pull the Dori checkout and apply it (a moved ref also wakes dori-update.path, whose run then logs UPDATE_SKIP)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.dori/dori.env
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/dori update --pull
