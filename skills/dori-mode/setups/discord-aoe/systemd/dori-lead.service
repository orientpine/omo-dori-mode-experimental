[Unit]
Description=Start the Dori's own aoe session at boot
After=dori-inbound.service

[Service]
Type=oneshot
RemainAfterExit=yes
KillMode=none
EnvironmentFile=%h/.dori/dori.env
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.dori/src/skills/dori-mode/setups/discord-aoe/self-restart.sh --start

[Install]
WantedBy=default.target
